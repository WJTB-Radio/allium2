{
	"compilerOptions": {
		"strict": true,
		"jsx": "react-jsx",
		"target": "ES2018",
		"allowJs": true,
		"module": "ES2022",
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noImplicitAny": true,
		"sourceMap": true,
		"baseUrl": ".",
		"outDir": "dist",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"paths": {
			"*": ["node_modules/*"]
		}
	},
	"include": ["src/**/*"]
}
